/* ========================================================= */
/* 1. GLOBAL STYLES                                          */
/* ========================================================= */
QWidget {
    font-family: 'Segoe UI', Arial, sans-serif;
    font-size: 14px;
    color: #333333;
    background-color: #F8F9FA; 
}

QLabel#TitleLabel {
    font-size: 22px;
    font-weight: bold;
    color: #111827; 
}

/* ========================================================= */
/* 2. INPUTS AND LISTS                                       */
/* ========================================================= */
QLineEdit, QListWidget {
    border: 1px solid #D1D5DB;
    border-radius: 6px;
    padding: 6px;
    background-color: #FFFFFF;
    color: #111827;
}

QLineEdit:focus, QListWidget:focus {
    border: 1px solid #2563EB; 
}

/* ========================================================= */
/* 2.1 QCOMBOBOX                                             */
/* ========================================================= */
QComboBox {
    border: 1px solid #D1D5DB;
    border-radius: 6px;
    padding: 6px 12px;
    background-color: #FFFFFF;
    color: #111827;
}

QComboBox:hover, QComboBox:focus {
    border: 1px solid #2563EB;
}

QComboBox QAbstractItemView {
    border: 1px solid #D1D5DB;
    border-radius: 6px;
    background-color: #FFFFFF;
    outline: 0px; 
    selection-background-color: #EFF6FF;
    selection-color: #2563EB;
}

QComboBox QAbstractItemView::item {
    min-height: 28px;
    padding-left: 8px;
    color: #374151;
}

QComboBox QAbstractItemView::item:hover,
QComboBox QAbstractItemView::item:selected {
    background-color: #EFF6FF; 
    color: #2563EB;            
}

/* ========================================================= */
/* 2.2 SPECIFIC WIDGETS                                      */
/* ========================================================= */
QGraphicsView#ViewerWidget {
    background-color: #E5E7EB;
    border: 1px solid #D1D5DB;
    border-radius: 6px;
}

QListWidget#ThumbnailList {
    background-color: #F3F4F6;
    border: 1px solid #D1D5DB;
    border-radius: 4px;
    padding: 5px;
}

QListWidget#ThumbnailList::item {
    border-radius: 4px;
}

QListWidget#ThumbnailList::item:selected {
    background-color: #DBEAFE; 
    border: 1px solid #93C5FD;
    color: #1D4ED8;
}

/* ========================================================= */
/* 3. PRIMARY BUTTONS                                        */
/* ========================================================= */
QPushButton {
    background-color: #2563EB; 
    color: white;
    border: none;
    border-radius: 6px;
    padding: 10px 20px;
    font-weight: bold;
}

QPushButton:hover { 
    background-color: #1D4ED8; 
}

/* ========================================================= */
/* 4. SPECIFIC BUTTON CLASSES                                */
/* ========================================================= */
QPushButton[class="SuccessButton"] { 
    background-color: #10B981; 
}

QPushButton[class="SuccessButton"]:hover { 
    background-color: #059669; 
}

QPushButton[class="SecondaryButton"] { 
    background-color: #EFF6FF; 
    color: #2563EB; 
    border: 1px solid #BFDBFE;
}

QPushButton[class="SecondaryButton"]:hover { 
    background-color: #DBEAFE; 
}

QPushButton[class="CloseButton"] {
    background-color: #EF4444; 
    color: white;
    border-radius: 10px; 
    padding: 2px;
    min-width: 20px; 
    min-height: 20px;
    max-width: 20px; 
    max-height: 20px;
}

QPushButton[class="CloseButton"]:hover { 
    background-color: #DC2626; 
}

QPushButton[class="DiscreteCloseButton"] {
    color: #9CA3AF;
    border: none;
    background: transparent;
    font-weight: normal;
    font-size: 16px;
    padding: 0px 5px;
}

QPushButton[class="DiscreteCloseButton"]:hover {
    color: #374151;
    font-weight: bold;
}

/* ========================================================= */
/* 5. SIDEBAR NAVIGATION                                     */
/* ========================================================= */
QWidget#Sidebar {
    background-color: #1F2937;
    border-right: 1px solid #111827;
}

QWidget#Sidebar QPushButton[class="SidebarButton"] {
    background-color: transparent;
    color: #D1D5DB; 
    text-align: left;
    padding: 12px 16px;
    font-weight: bold;
    border-radius: 4px;
    border: none;
}

QWidget#Sidebar QPushButton[class="SidebarButton"]:hover {
    background-color: #374151; 
    color: white;
}

QWidget#Sidebar QPushButton[class="SidebarButton"]:checked {
    background-color: #EE0000; 
    color: white;
}

QWidget#Sidebar QPushButton[class="HomeButton"] {
    background-color: transparent;
    color: #D1D5DB; 
    text-align: center; 
    padding: 12px 16px;
    font-weight: bold;
    border-radius: 4px;
    border: none;
}

QWidget#Sidebar QPushButton[class="HomeButton"]:hover {
    background-color: #374151; 
    color: white;
}

/* ========================================================= */
/* 6. CHECKBOXES AND LIST INDICATORS                         */
/* ========================================================= */
QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #9CA3AF;
    border-radius: 4px;
    background-color: #FFFFFF;
}

QCheckBox::indicator:hover {
    border: 1px solid #6B7280; 
}

QCheckBox::indicator:checked {
    background-color: #2563EB;
    border: 1px solid #2563EB;
}

QListView::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #9CA3AF;
    border-radius: 4px;
    background-color: #FFFFFF;
    margin-left: 5px; 
}

QListView::indicator:hover {
    border: 1px solid #6B7280;
}

QListView::indicator:checked {
    background-color: #10B981; 
    border: 1px solid #10B981;
}

/* ========================================================= */
/* 7. SCROLLBARS AND SPLITTERS                               */
/* ========================================================= */
QScrollBar:vertical {
    border: none;
    background-color: #F3F4F6;
    width: 12px;
    border-radius: 6px;
    margin: 0px 0px 0px 0px;
}

QScrollBar::handle:vertical {
    background-color: #D1D5DB;
    min-height: 20px;
    border-radius: 6px;
}

QScrollBar::handle:vertical:hover {
    background-color: #9CA3AF;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    border: none;
    background: none;
    height: 0px; 
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    border: none;
    background-color: #F3F4F6;
    height: 12px;
    border-radius: 6px;
    margin: 0px 0px 0px 0px;
}

QScrollBar::handle:horizontal {
    background-color: #D1D5DB;
    min-width: 20px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #9CA3AF;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    border: none;
    background: none;
    width: 0px; 
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}

QSplitter::handle {
    background-color: transparent;
}

QSplitter::handle:horizontal {
    width: 6px;
}

QSplitter::handle:hover {
    background-color: #D1D5DB; 
}